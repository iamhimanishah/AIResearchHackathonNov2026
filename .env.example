# Copy to .env (gitignored). Loaded by clharness.env at import time.
HF_TOKEN=hf_xxx            # read access to google/gemma-3-1b-pt and google/gemma-scope-2-1b-pt
WANDB_PROJECT=             # leave empty to run wandb in offline mode
WANDB_ENTITY=
WANDB_MODE=offline         # offline | online | disabled
EXA_API_KEY=               # Scout web search (clharness.agent.search); dashboard.exa.ai
TINKER_API_KEY=            # C5 second task sequence (clh tinker-run); tinker.thinkingmachines.ai
